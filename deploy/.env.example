# Copie para .env e preencha. NÃO versione o .env (já está no .gitignore).

# ---- Domínio / HTTPS ----
# Aponte um domínio (ou subdomínio) para o IP do VPS antes de subir.
# Para teste local sem domínio, use DOMAIN=localhost (Caddy usa certificado interno).
DOMAIN=crm.suaclinica.com.br
TLS_EMAIL=voce@suaclinica.com.br

# ---- Banco de dados (Postgres) ----
POSTGRES_USER=crm
POSTGRES_PASSWORD=troque_esta_senha_forte
POSTGRES_DB=crm

# ---- Segurança da API ----
# Gere uma chave real com no mínimo 32 bytes, ex.: openssl rand -base64 48
JWT_KEY=troque_por_uma_chave_secreta_aleatoria_com_no_minimo_32_bytes

# ---- Admin inicial (seed roda só uma vez, no primeiro start) ----
ADMIN_EMAIL=admin@suaclinica.com.br
ADMIN_SENHA=TroqueEstaSenha@123
ADMIN_NOME=Administrador
CLINICA_NOME=GA Clinic & Academy

# Popular o catálogo inicial de procedimentos no primeiro start (true/false).
# A clínica adiciona/edita os demais pela tela de Catálogo.
SEED_PROCEDIMENTOS=true

# Vagas de profissional contratadas (plano R$120/profissional). Só é lido no primeiro
# start (criação da clínica) — para mudar depois, atualize direto no banco:
#   UPDATE "Clinicas" SET "LimiteProfissionais" = <novo_valor>;
LIMITE_PROFISSIONAIS=5

# ---- Conta SuperAdmin (SUA conta de suporte — NÃO é da clínica) ----
# Acima do Admin da clínica: só ela cadastra/edita/reativa contas Profissional e redefine
# senha de terceiros. Deixe em branco (não preencha SUPERADMIN_SENHA) para não criar essa
# conta nesta clínica — mas sem ela, ninguém consegue liberar vaga de profissional depois.
SUPERADMIN_EMAIL=suporte@suaempresa.com.br
SUPERADMIN_SENHA=
SUPERADMIN_NOME=Suporte
